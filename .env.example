VITE_APP_NAME=Logistics
VITE_API_BASE_URL=http://localhost:8080/api
VITE_LARK_LOGIN_URL=http://localhost:8080/api/auth/lark/login

# Dev-only target for the Vite `/api` proxy (see vite.config.ts). The browser
# talks same-origin to the Vite dev server; this is where /api is forwarded.
# Docker Compose API: http://localhost:8080 — IntelliJ profile "local": http://localhost:18080
API_PROXY_TARGET=http://localhost:8080

# Adapter paths: update these values to match the real backend contract.
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_REFRESH_PATH=/auth/refresh
VITE_AUTH_ME_PATH=/auth/me
VITE_AUTH_LOGOUT_PATH=/auth/logout
VITE_TENANT_SWITCH_PATH=/auth/tenant/switch
VITE_TENANT_HEADER_NAME=X-Tenant-Key

# =============================================================================
# MAP & ROUTING CONFIGURATION (MapLibre, OSRM, Geocoding)
# =============================================================================
# Style bản đồ vector (OpenFreeMap miễn phí, không cần token):
# Lựa chọn: https://tiles.openfreemap.org/styles/liberty
# Hoặc Positron sáng: https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Routing API endpoint (OSRM public demo hoặc server OSRM nội bộ):
VITE_ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving

# Geocoding API endpoint (Photon OpenStreetMap miễn phí hoặc Goong/Nominatim):
VITE_GEOCODE_API_URL=https://photon.komoot.io/api
VITE_GEOCODE_API_KEY=
