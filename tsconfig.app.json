{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type Safety */
    "strict": true,

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@components": ["./src/components"],
      "@hooks/*": ["./src/hooks/*"],
      "@hooks": ["./src/hooks"],
      "@forms/*": ["./src/forms/*"],
      "@forms": ["./src/forms"],
      "@table/*": ["./src/table/*"],
      "@table": ["./src/table"],
      "@utils/*": ["./src/utils/*"],
      "@formatters/*": ["./src/formatters/*"],
      "@utils": ["./src/utils"],
      "@formatters": ["./src/formatters"],
      "@constants/*": ["./src/constants/*"],
      "@constants": ["./src/constants"],
      "@config/*": ["./src/config/*"],
      "@config": ["./src/config"],
      "@providers/*": ["./src/providers/*"],
      "@providers": ["./src/providers"],
      "@features/*": ["./src/features/*"],
      "@features": ["./src/features"],
      "@pages/*": ["./src/pages/*"],
      "@pages": ["./src/pages"],
      "@router/*": ["./src/router/*"],
      "@router": ["./src/router"],
      "@locales/*": ["./src/locales/*"],
      "@locales": ["./src/locales"],
      "@styles/*": ["./src/styles/*"],
      "@styles": ["./src/styles"],
      "@test/*": ["./src/tests/*"],
      "@test": ["./src/tests"],
      "@assets/*": ["./src/assets/*"],
      "@assets": ["./src/assets"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}